{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeetPilot",
  "version": "0.1.0",
  "identifier": "app.meetpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MeetPilot",
        "width": 1040,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      },
      {
        "label": "overlay",
        "title": "MeetPilot — capture indicator",
        "url": "index.html",
        "width": 360,
        "height": 480,
        "minWidth": 260,
        "minHeight": 96,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "x": 40,
        "y": 40
      },
      {
        "label": "assistant",
        "title": "MeetPilot — assistente",
        "url": "index.html",
        "width": 620,
        "height": 460,
        "minWidth": 420,
        "minHeight": 160,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private AI meeting copilot. Never joins your meetings.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    }
  }
}

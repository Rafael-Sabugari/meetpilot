# Copy to .env for local development. Never commit .env. Never put provider keys in the desktop app.
MEETPILOT_ENV=development
MEETPILOT_LOG_LEVEL=INFO
# MEETPILOT_DATABASE_URL=postgresql://meetpilot:meetpilot-dev-only@localhost:5432/meetpilot
# MEETPILOT_REDIS_URL=redis://localhost:6379/0
# MEETPILOT_JWT_SECRET=  # required in staging/production (32+ random bytes)
# MEETPILOT_CORS_ORIGINS=["http://localhost:5173"]

# Speech-to-text. "fake" (default) is a local placeholder for development; it does not
# recognize speech. Use "deepgram" with your own key for real transcription.
# MEETPILOT_STT_PROVIDER=deepgram
# MEETPILOT_DEEPGRAM_API_KEY=          # server-side only; never in the desktop app
# MEETPILOT_DEEPGRAM_MODEL=nova-3
# MEETPILOT_DEEPGRAM_MIP_OPT_OUT=true  # exclude audio from Deepgram model training (default)
# MEETPILOT_TRIAL_MINUTES_PER_MONTH=60

# Desktop dev only: force the macOS system-audio backend ("tap" or "sck").
# MEETPILOT_MACOS_SYSTEM_BACKEND=

# Copilot (LLM). "fake" (default) returns placeholder answers for development.
# MEETPILOT_LLM_PROVIDER=openai
# MEETPILOT_OPENAI_API_KEY=            # server-side only
# MEETPILOT_OPENAI_MODEL=gpt-5-mini
# MEETPILOT_OPENAI_REASONING_EFFORT=low
# MEETPILOT_COPILOT_REQUESTS_PER_MONTH=200
